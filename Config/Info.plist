<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Base Info.plist for the app. GENERATE_INFOPLIST_FILE stays YES, so the build merges
	     the INFOPLIST_KEY_* settings (usage strings, scene manifest, orientations, …) on top
	     of this. Only keys with no INFOPLIST_KEY_* equivalent live here — the custom URL scheme
	     the Share Extension uses to open the app, and the document types the app opens. Kept in
	     Config/ (not PhotoBrowser/) so the app target's synchronized file group doesn't try to
	     copy it into the bundle. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>jayymei.PhotoBrowser</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>photobrowser</string>
			</array>
		</dict>
	</array>
	<!-- App Transport Security: the in-app browser + downloader load and fetch arbitrary
	     user-chosen sites, including old members hosts on non-standard ports with legacy TLS
	     (e.g. www.<site>:444). iOS enforces ATS on a third-party app's WKWebView subresources
	     AND its URLSession downloads, but Safari is exempt — which is exactly why such sites'
	     images/videos render in Safari yet come back blank in the app.

	     ONLY NSAllowsArbitraryLoads is set — deliberately WITHOUT NSAllowsArbitraryLoadsInWebContent.
	     That's a documented ATS precedence trap: the moment a more-specific key (…InWebContent /
	     …ForMedia / …LocalNetworking) is present, iOS 10+ IGNORES NSAllowsArbitraryLoads for every
	     connection those keys don't cover — so adding the web-content key rescues the WKWebView but
	     silently demotes URLSession back to default ATS, which then blocks the legacy-TLS :444 media
	     host. That looked exactly like "the video plays in the browser but the download fails."
	     With no specific key present, NSAllowsArbitraryLoads alone disables ATS for BOTH the web view
	     and the downloader's URLSession — which is what loading/fetching arbitrary sites requires. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Files the app opens (they arrive in Documents/Inbox and reach `ArchiveIntake` through
	     onOpenURL): its own gallery archive, `.pbgallery` — what mac/airdrop_to_iphone.py sends, a zip
	     under a name only this app claims, so an AirDropped one offers "Open with Photo Browser" and
	     nothing else — and, as an Alternate handler, any file at all (`public.data`): a folder
	     AirDropped straight from Finder (which arrives as a zip), a PDF, a video, a document… all show
	     Photo Browser among the apps that can take them, and the Received sheet puts them on the drive.
	     Loose photos and videos AirDropped to an iPhone go straight into the Photos app — iOS decides
	     that before any app is asked; "Add from iOS Album" brings those over. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Photo Browser Gallery Archive</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>jayymei.PhotoBrowser.gallery-archive</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any File</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>jayymei.PhotoBrowser.gallery-archive</string>
			<key>UTTypeDescription</key>
			<string>Photo Browser Gallery Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pbgallery</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.photobrowser.gallery</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
